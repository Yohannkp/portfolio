{
  "name": "portfolio",
  "private": true,
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm-run-all clean build:html build:css build:js",
    "build:html": "eleventy",
    "build:css": "postcss src/styles/main.css --dir dist/assets/css",
    "build:js": "esbuild src/js/main.js --bundle --format=esm --target=es2019 --sourcemap --outdir=dist/assets/js",
    "dev": "npm-run-all clean --parallel dev:html dev:css dev:js",
    "dev:html": "eleventy --serve --watch",
    "dev:css": "postcss src/styles/main.css --watch --dir dist/assets/css --verbose",
    "dev:js": "esbuild src/js/main.js --bundle --format=esm --target=es2019 --outdir=dist/assets/js --sourcemap --watch"
  },
  "dependencies": {
    "animejs": "^4.0.2"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.23.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "rimraf": "^5.0.5"
  }
}
